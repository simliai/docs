{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "mint",
    "name": "Simli",
    "colors": {
        "primary": "#000000",
        "light": "#FFFFFF",
        "dark": "#000000"
    },
    "favicon": "/favicon.svg",
    "navigation": {
        "tabs": [
            {
                "tab": "Documentation",
                "pages": [
                    {
                        "group": "Get Started",
                        "pages": [
                            "overview",
                            "api-reference/create-avatar",
                            {
                                "group": "Trinity-2",
                                "icon": "star",
                                "pages": [
                                    "api-reference/trinity-2",
                                    "api-reference/trinity-2/camera",
                                    "api-reference/trinity-2/animations",
                                    "api-reference/trinity-2/backgrounds"
                                ]
                            },
                            "api-reference/preset-faces"
                        ]
                    },
                    {
                        "group": "Integrations",
                        "pages": [
                            "api-reference/livekit",
                            "api-reference/pipecat",
                            "api-reference/trinity-2/integration-workarounds"
                        ]
                    },
                    {
                        "group": "Simli SDKs",
                        "pages": [
                            "simli-sdks",
                            {
                                "group": "JavaScript SDK",
                                "icon": "js",
                                "pages": [
                                    "api-reference/javascript",
                                    "api-reference/javascript/trinity-2",
                                    "api-reference/javascript/reference"
                                ]
                            },
                            {
                                "group": "Python SDK",
                                "icon": "python",
                                "pages": [
                                    "api-reference/python",
                                    "api-reference/python/trinity-2",
                                    "api-reference/python/reference"
                                ]
                            }
                        ]
                    },
                    {
                        "group": "Starter repos",
                        "icon": "github",
                        "pages": [
                            "api-reference/samples/openai",
                            "api-reference/samples/elevenlabs",
                            "api-reference/samples/all-samples"
                        ]
                    },
                    {
                        "group": "Advanced: Custom Simli Client",
                        "pages": [
                            "api-reference/simli-webrtc",
                            {
                                "group": "WebRTC Guides",
                                "icon": "book",
                                "pages": [
                                    "api-reference/webrtc-info",
                                    "api-reference/audio-info"
                                ]
                            },
                            "api-reference/endpoint/webrtc/startAudioToVideoSession",
                            "api-reference/endpoint/webrtc/getIceServers"
                        ]
                    },
                    {
                        "group": "Links",
                        "pages": [
                            "api-reference/discord"
                        ]
                    }
                ]
            },
            {
                "tab": "REST API",
                "groups": [
                    {
                        "group": "Endpoints",
                        "openapi": {
                            "source": "https://api.simli.ai/openapi.yaml",
                            "directory": "api-reference"
                        }
                    },
                    {
                        "group": "WebSockets",
                        "asyncapi": {
                            "source": "/api-reference/asyncapi.yaml",
                            "directory": "api-reference"
                        }
                    },
                    {
                        "group": "OpenAPI Specs (Agent Friendly Format)",
                        "pages": [
                            "api-reference/openapi_doc",
                            "api-reference/asyncapi_doc"
                        ]
                    },
                    {
                        "group": "Simli Auto Guides (deprecated)",
                        "pages": [
                            "api-reference/endpoint/simli-auto/customLLM"
                        ]
                    }
                ]
            }
        ]
    },
    "redirects": [
        {
            "source": "/introduction",
            "destination": "/overview"
        },
        {
            "source": "/emotions",
            "destination": "/api-reference/trinity-2"
        },
        {
            "source": "/api-reference/create-simli-agent",
            "destination": "/api-reference/samples/all-samples"
        },
        {
            "source": "/api-reference/simli-client",
            "destination": "/api-reference/javascript"
        },
        {
            "source": "/api-reference/javascript_upgrade_guide",
            "destination": "/api-reference/javascript"
        },
        {
            "source": "/api-reference/python_upgrade_guide",
            "destination": "/api-reference/python"
        },
        {
            "source": "/api-reference/api_migration_guide",
            "destination": "/api-reference/compose-session-token"
        },
        {
            "source": "/api-reference/endpoint/assets/upload",
            "destination": "/api-reference/upload-background-or-foreground"
        },
        {
            "source": "/api-reference/endpoint/assets/list",
            "destination": "/api-reference/list-backgrounds-or-foregrounds"
        },
        {
            "source": "/api-reference/endpoint/assets/delete",
            "destination": "/api-reference/delete-a-background-or-foreground"
        }
    ],
    "logo": {
        "light": "/logo/light.svg",
        "dark": "/logo/dark.svg"
    },
    "appearance": {
        "default": "dark",
        "strict": true
    },
    "navbar": {
        "links": [
            {
                "label": "Need help, talk to us on Discord",
                "href": "https://discord.gg/yQx49zNF4d"
            }
        ],
        "primary": {
            "type": "button",
            "label": "Simli Dashboard",
            "href": "https://app.simli.com/"
        }
    }
}
